{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Stores user profile information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "string", "format": "date" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "UserPreferences": {
      "title": "UserPreferences",
      "description": "Stores user-specific application preferences.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "savedCareers": { "type": "array", "items": { "type": "string" } },
        "lastUpdated": { "type": "string", "format": "date" }
      },
      "required": ["uid", "lastUpdated"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "UserProfile",
      "description": "User profile documents."
    },
    "/users/{uid}/preferences/settings": {
      "schema": "UserPreferences",
      "description": "User preference settings."
    }
  }
}
